{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-I",
				"${workspaceFolder}/src/common",
				"-I",
				"${workspaceFolder}/src/proto",
				"-I",
				"${workspaceFolder}/src",
				"-I",
				"${workspaceFolder}/src/pch",
				"-c",
				"-g",
				"${file}",
				"-o",
				"${file}.o",
				"-fpermissive",
				"-DLINUX"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: /usr/bin/g++"
		}
	]
}